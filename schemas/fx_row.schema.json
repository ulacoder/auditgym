{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Строка fx.csv",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "source_currency",
    "target_currency",
    "rate"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "target_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "rate": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    }
  }
}
