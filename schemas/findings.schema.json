{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "findings.json — аргумент submit(findings)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "findings"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "affected_ids",
          "claimed_amount_minor",
          "currency",
          "evidence_ids",
          "explanation"
        ],
        "properties": {
          "type": {
            "enum": [
              "duplicate_invoice",
              "payment_allocation",
              "fx_conversion",
              "period_cutoff"
            ],
            "description": "case-insensitive, surrounding spaces ignored"
          },
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string"
            },
            "description": "compared as a set after ASCII strip+upper; non-ASCII strings are never normalized"
          },
          "claimed_amount_minor": {
            "type": "integer",
            "description": "absolute misstatement in base-currency minor units; sign ignored"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "pattern": "^[A-Za-z]{3}$"
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
