{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "findings.json — аргумент submit(findings)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "findings"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "affected_ids",
          "claimed_amount_minor",
          "currency",
          "evidence_ids",
          "explanation"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "exact match to one of the documented types (case- and whitespace-sensitive); an unknown string type is unmatched (FP)",
            "examples": [
              "duplicate_invoice",
              "payment_allocation",
              "fx_conversion",
              "period_cutoff"
            ]
          },
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string"
            },
            "description": "exact set of ids (case- and whitespace-sensitive); order and repeats inside the list are ignored"
          },
          "claimed_amount_minor": {
            "type": "integer",
            "description": "absolute misstatement in base-currency minor units (positive JSON integer); |claimed - true| <= policy.tolerance.amount_minor (0)"
          },
          "currency": {
            "type": "string",
            "description": "exact match to the base currency code in manifest/policy (no case change or trimming); a different value is unmatched (FP)"
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
